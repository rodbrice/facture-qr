{
  "openapi": "3.1.1",
  "info": {
    "title": "FactureQr.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/customers": {
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Creates a customer.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Lists the customers by name.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CustomerResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Returns one customer.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Creates a draft for a customer, optionally with its lines.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoiceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Lists the invoices, newest first, each with its status and whether it is overdue.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvoiceSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{id}": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Returns one invoice with its lines.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{id}/lines": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Adds a line at the end of a draft.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{id}/lines/{lineId}": {
      "delete": {
        "tags": [
          "Invoices"
        ],
        "summary": "Removes a line from a draft; the following lines move up.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lineId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{id}/issue": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Issues a draft: gives it the next number of the year and freezes it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/IssueRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{id}/mark-paid": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Records that an issued invoice was paid.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/MarkPaidRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{id}/pdf": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Returns the invoice as a one-page A4 PDF with its QR-bill payment part.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressDto": {
        "required": [
          "name",
          "postalCode",
          "town",
          "country"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the person or company, at most 70 characters."
          },
          "postalCode": {
            "type": "string",
            "description": "Postal code without country prefix, at most 16 characters."
          },
          "town": {
            "type": "string",
            "description": "Town, at most 35 characters."
          },
          "country": {
            "type": "string",
            "description": "Two-letter ISO 3166-1 country code, for example CH."
          },
          "street": {
            "type": [
              "null",
              "string"
            ],
            "description": "Street or P.O. box, at most 70 characters; may be omitted."
          },
          "buildingNumber": {
            "type": [
              "null",
              "string"
            ],
            "description": "Building number, at most 16 characters; may be omitted."
          }
        },
        "description": "A structured address as the QR-bill requires it (no combined address lines)."
      },
      "CreateInvoiceRequest": {
        "required": [
          "customerId"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "The customer; the draft copies the customer\u0027s current address.",
            "format": "uuid"
          },
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/LineRequest"
            },
            "description": "The lines to add, in order; may be omitted."
          }
        },
        "description": "A new draft for a customer, optionally with its first lines."
      },
      "CustomerResponse": {
        "required": [
          "id",
          "address"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier.",
            "format": "uuid"
          },
          "address": {
            "description": "The structured address, including the name.",
            "$ref": "#/components/schemas/AddressDto"
          }
        },
        "description": "A customer."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InvoiceResponse": {
        "required": [
          "id",
          "number",
          "status",
          "overdue",
          "customerId",
          "billTo",
          "lines",
          "total",
          "issueDate",
          "dueDate",
          "paidOn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier.",
            "format": "uuid"
          },
          "number": {
            "type": [
              "null",
              "string"
            ],
            "description": "The number (\u00602026-0001\u0060), or null for a draft."
          },
          "status": {
            "description": "Draft, Issued or Paid.",
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "overdue": {
            "type": "boolean",
            "description": "True when issued, not paid, and past its due date (Swiss date)."
          },
          "customerId": {
            "type": "string",
            "description": "The customer.",
            "format": "uuid"
          },
          "billTo": {
            "description": "The address copied onto the invoice.",
            "$ref": "#/components/schemas/AddressDto"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineResponse"
            },
            "description": "The lines, in order."
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The sum of the line amounts, in CHF.",
            "format": "double"
          },
          "issueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The issue date, or null for a draft.",
            "format": "date"
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The due date, or null for a draft.",
            "format": "date"
          },
          "paidOn": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payment date, or null when not paid.",
            "format": "date"
          }
        },
        "description": "An invoice with its lines."
      },
      "InvoiceStatus": {
        "enum": [
          "Draft",
          "Issued",
          "Paid"
        ],
        "description": "The stored states of an invoice. A draft can be edited; issuing gives it a\nnumber and freezes it; an issued invoice can only be marked as paid.\n\u0022Overdue\u0022 is not a stored state: it is derived from the due date, see\nbool Invoice.IsOverdue(DateOnly today)."
      },
      "InvoiceSummary": {
        "required": [
          "id",
          "number",
          "status",
          "overdue",
          "customerId",
          "customerName",
          "total",
          "issueDate",
          "dueDate",
          "paidOn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier.",
            "format": "uuid"
          },
          "number": {
            "type": [
              "null",
              "string"
            ],
            "description": "The number, or null for a draft."
          },
          "status": {
            "description": "Draft, Issued or Paid.",
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "overdue": {
            "type": "boolean",
            "description": "True when issued, not paid, and past its due date."
          },
          "customerId": {
            "type": "string",
            "description": "The customer.",
            "format": "uuid"
          },
          "customerName": {
            "type": "string",
            "description": "The name copied onto the invoice."
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The total in CHF.",
            "format": "double"
          },
          "issueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The issue date, or null for a draft.",
            "format": "date"
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The due date, or null for a draft.",
            "format": "date"
          },
          "paidOn": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payment date, or null when not paid.",
            "format": "date"
          }
        },
        "description": "An invoice in a list, without its lines."
      },
      "IssueRequest": {
        "type": "object",
        "properties": {
          "issueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The issue date; today in Switzerland when omitted.",
            "format": "date"
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The due date; the issue date plus 30 days when omitted.",
            "format": "date"
          }
        },
        "description": "The dates of an issue. Both may be omitted."
      },
      "LineRequest": {
        "required": [
          "description",
          "quantity",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "What is invoiced, at most 200 characters, on one line. Typographic apostrophes, quotes, dashes and the ellipsis are replaced by their plain equivalents; a character the PDF cannot print is refused."
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Greater than 0, at most three decimals.",
            "format": "double"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Price of one unit in CHF, 0 or more, at most two decimals.",
            "format": "double"
          }
        },
        "description": "A line to add to a draft."
      },
      "LineResponse": {
        "required": [
          "id",
          "position",
          "description",
          "quantity",
          "unitPrice",
          "amount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier, used to remove the line from a draft.",
            "format": "uuid"
          },
          "position": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Position on the invoice, starting at 1.",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "description": "What is invoiced."
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The quantity.",
            "format": "double"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The price of one unit in CHF.",
            "format": "double"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Quantity \u00D7 unit price, rounded to the centime.",
            "format": "double"
          }
        },
        "description": "A line of an invoice."
      },
      "MarkPaidRequest": {
        "type": "object",
        "properties": {
          "paidOn": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payment date; today in Switzerland when omitted. Not before the issue date, not in the future.",
            "format": "date"
          }
        },
        "description": "The date a payment was received."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Customers"
    },
    {
      "name": "Invoices"
    }
  ]
}
